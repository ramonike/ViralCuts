{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "enabled": true,
      "headers": {
        "X-Goog-Api-Key": "AQ.Ab8RN6L2QNpjuDypbRGd_p-dntxXJJs8SbJYOzuS-S-XfMqzNA"
      }
    },
    "21st-magic": {
      "type": "local",
      "command": ["npx", "-y", "@21st-dev/magic@latest"],
      "enabled": true,
      "environment": {
        "API_KEY": "{env:API_KEY_21ST}"
      }
    },
    "gemini": {
      "type": "local",
      "command": ["npx", "-y", "@mintmcqueen/gemini-mcp@latest"],
      "enabled": true,
      "environment": {
        "GEMINI_API_KEY": "{env:GEMINI_API_KEY}"
      }
    }
  }
}
