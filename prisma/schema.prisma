generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false) @map("email_verified")
  image         String?
  role          String        @default("user")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  sessions      Session[]
  accounts      Account[]
  videos        Video[]
  uploads       Upload[]
  progress      UserProgress?
  achievements  Achievement[]
  settings      UserSettings?
  notifications Notification[]
  
  // Command Center Relations
  commandCenterState CommandCenterState?
  dailyTasks         DailyTask[]
  userMetrics        UserMetrics[]
  userActivities     UserActivity[]
  subscription  Subscription?
  
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")
  @@map("verification")
}


model Video {
  id          String   @id @default(cuid())
  title       String
  description String?
  youtubeId   String?  @map("youtube_id")
  thumbnail   String?
  status      String   @default("draft")
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  uploads     Upload[]
  @@map("video")
}


model Upload {
  id            String    @id @default(cuid())
  videoId       String?   @map("video_id")
  video         Video?    @relation(fields: [videoId], references: [id])
  platform      String    @default("youtube")
  platforms     String[]  @default(["youtube"])
  status        String    @default("pending")
  scheduledAt   DateTime? @map("scheduled_at")
  publishedAt   DateTime? @map("published_at")
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  metadata      Json?
  // Resumable upload fields
  sessionUri    String?   @map("session_uri")
  fileName      String?   @map("file_name")
  fileSize      BigInt?   @map("file_size")
  mimeType      String?   @map("mime_type")
  bytesUploaded BigInt    @default(0) @map("bytes_uploaded")
  youtubeVideoId String?  @map("youtube_video_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  // Multi-platform status tracking
  platformStatuses PlatformUploadStatus[]
  @@map("upload")
}


model PlatformUploadStatus {
  id              String    @id @default(cuid())
  uploadId        String    @map("upload_id")
  upload          Upload    @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  platform        String    // 'youtube' | 'tiktok' | 'instagram'
  status          String    @default("pending") // 'pending' | 'uploading' | 'processing' | 'published' | 'failed'
  platformVideoId String?   @map("platform_video_id")
  platformVideoUrl String?  @map("platform_video_url")
  scheduledAt     DateTime? @map("scheduled_at")
  publishedAt     DateTime? @map("published_at")
  error           String?
  metadata        Json?     // Platform-specific metadata
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  @@unique([uploadId, platform])
  @@map("platform_upload_status")
}


model UserProgress {
  id                  String   @id @default(cuid())
  currentStage        String   @default("setup") @map("current_stage")
  completedMilestones String[] @map("completed_milestones")
  experienceLevel     String   @default("beginner") @map("experience_level")
  totalPoints         Int      @default(0) @map("total_points")
  currentStreak       Int      @default(0) @map("current_streak")
  lastActiveDate      DateTime @default(now()) @map("last_active_date")
  onboardingCompleted Boolean  @default(false) @map("onboarding_completed")
  userId              String   @unique @map("user_id")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  @@map("user_progress")
}


model Achievement {
  id            String   @id @default(cuid())
  achievementId String   @map("achievement_id")
  unlockedAt    DateTime @default(now()) @map("unlocked_at")
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now()) @map("created_at")
  @@unique([userId, achievementId])
  @@map("achievement")
}


model UserSettings {
  id             String  @id @default(cuid())
  theme          String  @default("dark")
  notifications  Boolean @default(true)
  defaultPrivacy String  @default("private") @map("default_privacy")
  userId         String  @unique @map("user_id")
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("user_settings")
}


model Notification {
  id        String   @id @default(cuid())
  type      String   @default("info")
  title     String
  message   String
  data      Json?
  read      Boolean  @default(false)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  @@map("notification")
}

// Command Center Models
model CommandCenterState {
  id                    String   @id @default(cuid())
  userId                String   @unique @map("user_id")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Setup Progress
  setupCompleted        Boolean  @default(false) @map("setup_completed")
  completedSetupTasks   String[] @map("completed_setup_tasks")
  setupProgress         Int      @default(0) @map("setup_progress")
  
  // User Goals and Preferences
  focusAreas            String[] @map("focus_areas") // ['growth', 'engagement', 'monetization']
  dailyUploadTarget     Int      @default(1) @map("daily_upload_target")
  weeklyUploadTarget    Int      @default(3) @map("weekly_upload_target")
  
  // Feature Flags
  enabledFeatures       String[] @map("enabled_features")
  
  // Widget Layout
  widgetLayout          Json?    @map("widget_layout")
  
  // Current Workflow
  currentWorkflow       Json?    @map("current_workflow")
  
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  
  @@map("command_center_state")
}

model DailyTask {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title           String
  description     String
  type            String    // 'creation', 'optimization', 'analysis', 'planning'
  estimatedTime   Int       @map("estimated_time") // in minutes
  expectedOutcome String    @map("expected_outcome")
  priority        Int       @default(5) // 1-10 scale
  
  // Progress tracking
  progress        Int       @default(0) // 0-100 percentage
  completed       Boolean   @default(false)
  completedAt     DateTime? @map("completed_at")
  
  // Scheduling
  scheduledDate   DateTime  @map("scheduled_date") // Date this task is for
  deadline        DateTime?
  
  // Metadata
  metadata        Json?     // Additional task-specific data
  
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  @@index([userId, scheduledDate])
  @@map("daily_task")
}

model UserMetrics {
  id                      String   @id @default(cuid())
  userId                  String   @map("user_id")
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Time period for these metrics
  periodStart             DateTime @map("period_start")
  periodEnd               DateTime @map("period_end")
  periodType              String   @map("period_type") // 'daily', 'weekly', 'monthly'
  
  // Content Creation Metrics
  videosCreated           Int      @default(0) @map("videos_created")
  videosUploaded          Int      @default(0) @map("videos_uploaded")
  totalWatchTime          Int      @default(0) @map("total_watch_time") // in minutes
  
  // Channel Growth Metrics
  subscribersGained       Int      @default(0) @map("subscribers_gained")
  subscribersLost         Int      @default(0) @map("subscribers_lost")
  totalSubscribers        Int      @default(0) @map("total_subscribers")
  totalViews              Int      @default(0) @map("total_views")
  averageViewDuration     Float    @default(0) @map("average_view_duration") // in seconds
  
  // Engagement Metrics
  totalLikes              Int      @default(0) @map("total_likes")
  totalComments           Int      @default(0) @map("total_comments")
  totalShares             Int      @default(0) @map("total_shares")
  engagementRate          Float    @default(0) @map("engagement_rate") // percentage
  
  // Consistency Metrics
  uploadConsistency       Float    @default(0) @map("upload_consistency") // percentage
  dailyActivityStreak     Int      @default(0) @map("daily_activity_streak")
  weeklyUploadStreak      Int      @default(0) @map("weekly_upload_streak")
  contentCreationStreak   Int      @default(0) @map("content_creation_streak")
  
  // Performance Metrics
  clickThroughRate        Float    @default(0) @map("click_through_rate") // percentage
  retentionRate           Float    @default(0) @map("retention_rate") // percentage
  
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")
  
  @@unique([userId, periodStart, periodEnd, periodType])
  @@index([userId, periodType])
  @@map("user_metrics")
}

model UserActivity {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type        String   // 'upload', 'content_creation', 'engagement', 'optimization'
  action      String   // Specific action taken
  description String?  // Human readable description
  
  // Context and metadata
  metadata    Json?    // Additional context data
  
  // Tracking
  timestamp   DateTime @default(now())
  sessionId   String?  @map("session_id") // To group related activities
  
  createdAt   DateTime @default(now()) @map("created_at")
  
  @@index([userId, type])
  @@index([userId, timestamp])
  @@map("user_activity")
}
model BetaRequest {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
  gmail       String
  channelName String?  @map("channel_name")
  status      String   @default("pending")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("beta_request")
}

model Plan {
  id                   String         @id @default(cuid())
  name                 String         @unique
  displayName          String
  maxChannels          Int
  priceMonthly         Int
  priceYearly          Int
  stripePriceIdMonthly String?        @map("stripe_price_id_monthly")
  stripePriceIdYearly  String?        @map("stripe_price_id_yearly")
  active               Boolean        @default(true)
  subscriptions        Subscription[]

  @@map("plan")
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique @map("user_id")
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId               String    @map("plan_id")
  plan                 Plan      @relation(fields: [planId], references: [id])
  status               String    @default("active")
  billingCycle         String    @default("monthly") @map("billing_cycle")
  stripeCustomerId     String?   @map("stripe_customer_id")
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  currentPeriodStart   DateTime? @map("current_period_start")
  currentPeriodEnd     DateTime? @map("current_period_end")
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("subscription")
}

